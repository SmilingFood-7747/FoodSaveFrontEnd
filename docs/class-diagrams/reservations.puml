@startuml
title FoodSave - Reservas y recojo
hide empty members
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam nodesep 35
skinparam ranksep 45
skinparam ArrowColor #61736A
skinparam ArrowThickness 1.2
skinparam BackgroundColor white
skinparam PackageBorderColor #A7B8AE
skinparam PackageBackgroundColor #FAFCFB
skinparam ClassBorderColor #446452
skinparam ClassBackgroundColor #F1F7F3
skinparam ClassHeaderBackgroundColor #DEEBE2
skinparam ClassFontColor #182B21
skinparam PackageFontColor #30483A
skinparam TitleFontSize 22
skinparam TitleFontColor #182B21

package "reservations" as reservations_context {
    enum "ReservationStatus" as ReservationStatus {
      ACTIVE
      COLLECTED
      CANCELLED
      EXPIRED
    }
    interface "ReservationData" as ReservationData {
      +id: number
      +offerId: number
      +customerUserId: number
      +quantity: number
      +unitPrice: number
      +originalUnitPrice: number
      +pickupCode: string
      +pickupStartAt: string
      +pickupDeadlineAt: string
      +status: ReservationStatus
      +createdAt: string
      +collectedAt?: string
    }
    class "Reservation" as Reservation {
      +status: ReservationStatus
      +cancel(): ReservationData
      +collect(): ReservationData
    }
    abstract class "ReservationRepository" as ReservationRepository {
      +all(): ReservationData[]
      +save(reservation: ReservationData): void
    }
    class "ReservationService" as ReservationService <<Service>> {
      +all
      +mine
      +businessReservations
      +create(offerId: number, quantity: number): ReservationData
      +cancel(id: number): void
      +confirmPickup(code: string): ReservationData
    }
    class "BrowserReservationRepository" as BrowserReservationRepository <<Adapter>> {
      +all(): ReservationData[]
      +save(reservation: ReservationData): void
    }
    class "Reservations" as Reservations <<Component>> {
    }
}
package "Dependencias de otros contextos" as external_context {
  class "BrowserDatabase" as BrowserDatabase <<Adapter>>
  class "BusinessService" as BusinessService <<Service>>
  class "ClockService" as ClockService <<Service>>
  class "OfferService" as OfferService <<Service>>
  class "SessionService" as SessionService <<Service>>
}


ReservationService ..> ReservationRepository
ReservationRepository <|-- BrowserReservationRepository
Reservations ..> ReservationService
Reservation --> ReservationData
ReservationData --> ReservationStatus : status
ReservationService ..> OfferService
ReservationService ..> BusinessService
ReservationService ..> SessionService
ReservationService ..> BrowserDatabase
ReservationService ..> ClockService
BrowserReservationRepository ..> BrowserDatabase
interface "Account" as Account
interface "OfferData" as OfferData
ReservationData "0..*" --> "1" Account : cliente
ReservationData "0..*" --> "1" OfferData : oferta
@enduml
