@startuml
title FoodSave - Ofertas
hide empty members
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam nodesep 35
skinparam ranksep 45
skinparam ArrowColor #61736A
skinparam ArrowThickness 1.2
skinparam BackgroundColor white
skinparam PackageBorderColor #A7B8AE
skinparam PackageBackgroundColor #FAFCFB
skinparam ClassBorderColor #446452
skinparam ClassBackgroundColor #F1F7F3
skinparam ClassHeaderBackgroundColor #DEEBE2
skinparam ClassFontColor #182B21
skinparam PackageFontColor #30483A
skinparam TitleFontSize 22
skinparam TitleFontColor #182B21

package "offers" as offers_context {
    enum "OfferStatus" as OfferStatus {
      ACTIVE
      PAUSED
      EXPIRED
    }
    interface "OfferData" as OfferData {
      +id: number
      +businessId: number
      +category: string
      +title: string
      +description: string
      +allergens: string
      +originalPrice: number
      +offerPrice: number
      +initialUnits: number
      +availableUnits: number
      +pickupStartAt: string
      +pickupEndAt: string
      +expiresAt: string
      +status: OfferStatus
      +image: string
    }
    class "Offer" as Offer {
      +{static} validate(data: OfferData): void
      +status: OfferStatus
      +discount: number
      +isReservable(quantity: number): boolean
      +allocate(quantity: number): OfferData
      +release(quantity: number): OfferData
    }
    abstract class "OfferRepository" as OfferRepository {
      +all(): OfferData[]
      +save(offer: OfferData): void
    }
    class "OfferService" as OfferService <<Service>> {
      +all
      +active
      +owned
      +get(id: number): OfferData | undefined
      +save(data, id?: number): OfferData
      +pause(id: number): void
    }
    class "BrowserOfferRepository" as BrowserOfferRepository <<Adapter>> {
      +all(): OfferData[]
      +save(offer: OfferData): void
    }
    class "Catalog" as Catalog <<Component>> {
    }
    class "OfferCard" as OfferCard <<Component>> {
    }
    class "ManageOffers" as ManageOffers <<Component>> {
    }
    class "OfferDetail" as OfferDetail <<Component>> {
    }
    class "OfferEditor" as OfferEditor <<Component>> {
    }
}
package "Dependencias de otros contextos" as external_context {
  class "BrowserDatabase" as BrowserDatabase <<Adapter>>
  class "BusinessService" as BusinessService <<Service>>
  class "ClockService" as ClockService <<Service>>
  class "SessionService" as SessionService <<Service>>
}


OfferService ..> OfferRepository
OfferRepository <|-- BrowserOfferRepository
Catalog ..> OfferService
ManageOffers ..> OfferService
OfferDetail ..> OfferService
OfferEditor ..> OfferService
Catalog --> OfferCard
Offer --> OfferData
OfferData --> OfferStatus : status
OfferService ..> BusinessService
OfferService ..> SessionService
OfferService ..> BrowserDatabase
OfferService ..> ClockService
BrowserOfferRepository ..> BrowserDatabase
interface "Business" as Business
OfferData "0..*" --> "1" Business : negocio
@enduml
