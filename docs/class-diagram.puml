@startuml
title FoodSave - Clases principales del frontend
left to right direction
hide empty members
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam nodesep 35
skinparam ranksep 45
skinparam ArrowColor #61736A
skinparam ArrowThickness 1.2
skinparam BackgroundColor white
skinparam PackageBorderColor #A7B8AE
skinparam PackageBackgroundColor #FAFCFB
skinparam ClassBorderColor #446452
skinparam ClassBackgroundColor #F1F7F3
skinparam ClassHeaderBackgroundColor #DEEBE2
skinparam ClassFontColor #182B21
skinparam PackageFontColor #30483A
skinparam TitleFontSize 22
skinparam TitleFontColor #182B21

interface "Account" as Account  {
      +id: number
      +fullName: string
      +email: string
      +role: AccountRole
}

interface "Business" as Business  {
      +id: number
      +ownerAccountId: number
      +name: string
      +address: string
      +district: string
}

interface "OfferData" as OfferData  {
      +id: number
      +businessId: number
      +title: string
      +offerPrice: number
      +availableUnits: number
      +status: OfferStatus
}

interface "ReservationData" as ReservationData  {
      +id: number
      +offerId: number
      +customerUserId: number
      +quantity: number
      +pickupCode: string
      +status: ReservationStatus
}

interface "Notification" as Notification  {
      +id: number
      +recipientAccountId: number
      +reservationId?: number
      +type: Notification["type"]
      +readAt?: string
}

interface "NotificationPreferences" as NotificationPreferences  {
      +emailEnabled: boolean
      +pushEnabled: boolean
      +remindersEnabled: boolean
}

interface "Review" as Review  {
      +id: number
      +reservationId: number
      +rating: number
      +comment: string
}

interface "SupportRequest" as SupportRequest  {
      +id: number
      +requesterAccountId: number
      +reservationId?: number
      +subject: string
      +status: 'OPEN' | 'CLOSED'
}

class "Offer" as Offer  {

      +{static} validate(data: OfferData): void
      +status: OfferStatus
      +discount: number
      +isReservable(quantity: number): boolean
      +allocate(quantity: number): OfferData
      +release(quantity: number): OfferData
    
}

class "Reservation" as Reservation  {

      +status: ReservationStatus
      +cancel(): ReservationData
      +collect(): ReservationData
    
}

enum "AccountRole" as AccountRole  {

      CUSTOMER
      BUSINESS_OWNER
    
}

enum "OfferStatus" as OfferStatus  {

      ACTIVE
      PAUSED
      EXPIRED
    
}

enum "ReservationStatus" as ReservationStatus  {

      ACTIVE
      COLLECTED
      CANCELLED
      EXPIRED
    
}

Account "1" -- "0..*" Business : propietario
Business "1" -- "0..*" OfferData : negocio
OfferData "1" -- "0..*" ReservationData : oferta
Account "1" -- "0..*" ReservationData : cliente
ReservationData "0..1" -- "0..*" Notification : avisos
ReservationData "0..1" -- "0..*" SupportRequest : solicitudes
ReservationData "1" -- "0..1" Review : opinión
Account "1" -- "0..1" NotificationPreferences : preferencias
Offer ..> OfferData
Reservation ..> ReservationData
Account --> AccountRole
OfferData --> OfferStatus
ReservationData --> ReservationStatus
@enduml
