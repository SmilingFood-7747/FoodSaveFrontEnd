App --> Layout : contiene
App --> Content : contiene
App --> Footer : contiene
Layout --> Header : contiene
Header --> LanguageSwitcher : contiene
Catalog --> OfferCard : contiene
Offer --> OfferData : encapsula reglas
Reservation --> ReservationData : encapsula reglas
Account "1" <-- "0..*" Business : ownerAccountId
Business "1" <-- "0..*" OfferData : businessId
OfferData "1" <-- "0..*" ReservationData : offerId
Account "1" <-- "0..*" ReservationData : customerUserId
Account "1" <-- "0..*" Notification : recipientAccountId
ReservationData "0..1" <-- "0..*" Notification : reservationId opcional
ReservationData "1" <-- "0..1" Review : reservationId
Account "1" <-- "0..*" SupportRequest : requesterAccountId
ReservationData "0..1" <-- "0..*" SupportRequest : reservationId opcional
Account "1" -- "0..1" NotificationPreferences : preferencias por cuenta
BrowserDatabase --> LocalDatabase : estado local
OfferData --> OfferStatus : status
ReservationData --> ReservationStatus : status
Account --> AccountRole : role

@enduml
