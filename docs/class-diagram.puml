BusinessRepository <|-- BrowserBusinessRepository
BrowserBusinessRepository ..> BrowserDatabase : usa
BusinessProfile ..> BusinessService : usa
BusinessProfile ..> SessionService : usa
BusinessProfile ..> OfferService : usa
Dashboard ..> ReportingService : usa
Dashboard ..> BusinessService : usa
Dashboard ..> SessionService : usa
